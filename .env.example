# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Neo4j ────────────────────────────────────────────────────────────────────
# Local (running outside Docker): bolt://localhost:7687
# Inside Docker Compose (auto-overridden by docker-compose.yml): bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ─── App Settings ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CEFR_REFERENCE_PATH=./knowledge_graph/data/cefr_wordlist.json
ROLLING_BASELINE_SESSIONS=5
